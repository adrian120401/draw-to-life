    {
      "name": "Subí tu dibujo",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Solid violet upload or recovery action.",
      "html": "<button class=\"ds-button-primary\">Subí tu dibujo</button>",
      "css": ".ds-button-primary{background:var(--violet,#6c4699);color:white;border:0;border-radius:22px;padding:19px 30px;min-width:224px;font:700 20px \"Trebuchet MS\",sans-serif;box-shadow:0 6px 18px #69418d20;cursor:pointer}.ds-button-primary:hover{background:#5d3688}.ds-button-primary:disabled{opacity:.55}.ds-button-primary:focus-visible{outline:3px solid #724796;outline-offset:5px}"
    },
    {
