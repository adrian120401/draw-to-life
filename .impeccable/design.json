      "css": ".ds-sound{background:var(--cream,#fffaf1);color:var(--ink,#493366);border:0;border-radius:50%;width:44px;height:44px;display:grid;place-items:center;cursor:pointer}.ds-sound svg{width:20px;height:20px}.ds-sound:focus-visible{outline:3px solid #724796;outline-offset:5px}"
